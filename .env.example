# Supabase Configuration
# Get these values from your Supabase project settings at https://supabase.com/dashboard
VITE_SUPABASE_PROJECT_ID=your_project_id_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Cloudflare Turnstile — REQUIRED FOR PRODUCTION BUILDS.
# This value is inlined at BUILD time, so it must be set BEFORE `npm run build`.
# A production build without it renders a visible error and BLOCKS signup and
# club claims entirely (fail-closed, by design). Pair it with the server-side
# TURNSTILE_SECRET_KEY in the Supabase Edge Function secrets, from the same widget.
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
